    {
      "name": "4. OAuth 2.0 (GitHub) - see README section 'OAuth 2.0'",
      "item": [
        {
          "name": "Create product with OAuth 2.0 access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "grant_type",
                  "value": "authorization_code_with_pkce",
                  "type": "string"
                },
                {
                  "key": "authUrl",
                  "value": "https://github.com/login/oauth/authorize",
                  "type": "string"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://github.com/login/oauth/access_token",
                  "type": "string"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://oauth.pstmn.io/v1/callback",
                  "type": "string"
                },
                {
                  "key": "clientId",
                  "value": "PASTE_YOUR_GITHUB_CLIENT_ID",
                  "type": "string"
                },
                {
                  "key": "clientSecret",
                  "value": "PASTE_YOUR_GITHUB_CLIENT_SECRET",
                  "type": "string"
                },
                {
                  "key": "scope",
                  "value": "openid email profile",
                  "type": "string"
                },
                {
                  "key": "challengeAlgorithm",
                  "value": "S256",
                  "type": "string"
                },
                {
                  "key": "useBrowser",
                  "value": true,
                  "type": "boolean"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pearl Drop Earrings\",\n  \"description\": \"Gold-colored stainless steel earrings with a small pearl.\",\n  \"price\": 450,\n  \"category\": \"Earrings\",\n  \"imageUrl\": \"/products/clover-earrings.jpg\",\n  \"stock\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
